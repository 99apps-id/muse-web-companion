{
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "category": "Muse Companion",
        "command": "museCompanion.openMuse",
        "title": "Muse: Open Muse Web (muse.ai)"
      },
      {
        "command": "museCompanion.openChat",
        "title": "Muse: Open the Muse Chat Panel",
        "category": "Muse Companion",
        "icon": "$(sparkle)"
      },
      {
        "command": "museCompanion.openSettings",
        "title": "Muse: Relay Settings (in the Chat panel)",
        "category": "Muse Companion",
        "icon": "$(gear)"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.askTunnelReadFile",
        "title": "Muse: Ask Muse to Read This File from My Machine (via tunnel)"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.askTunnelReadWorkspace",
        "title": "Muse: Ask Muse to Read This Workspace from My Machine (via tunnel)"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.sendFile",
        "title": "Muse: Copy Active File as Context + Open Muse"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.askAboutFile",
        "title": "Muse: Ask about the Active File..."
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.sendSelection",
        "title": "Muse: Copy Selection as Context + Open Muse"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.sendWorkspaceTree",
        "title": "Muse: Copy Workspace Tree + Open Muse"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.sendGitDiff",
        "title": "Muse: Copy Git Status + Diff + Open Muse"
      },
      {
        "category": "Muse Companion",
        "command": "museCompanion.sendDiagnostics",
        "title": "Muse: Copy Problems/Diagnostics + Open Muse"
      }
    ],
    "configuration": {
      "properties": {
        "museCompanion.maxChars": {
          "default": 100000,
          "description": "Character limit for copied file/diff content (the rest is truncated with a note).",
          "type": "number"
        },
        "museCompanion.museUrl": {
          "default": "https://muse.ai",
          "description": "The Muse web URL the extension opens.",
          "type": "string"
        },
        "museCompanion.openAfterCopy": {
          "default": true,
          "description": "Open muse.ai in the browser after copying context to the clipboard.",
          "type": "boolean"
        },
        "museCompanion.relayDir": {
          "default": "",
          "description": "Optional custom path to the muse-relay folder (defaults to ~/muse-relay or the MUSE_RELAY_DIR environment variable).",
          "type": "string"
        }
      },
      "title": "Muse Companion"
    },
    "keybindings": [
      {
        "command": "museCompanion.openMuse",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "museCompanion.askTunnelReadFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "museCompanion.sendSelection",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "museCompanion.askTunnelReadFile",
          "group": "muse@1"
        },
        {
          "command": "museCompanion.sendSelection",
          "group": "muse@2",
          "when": "editorHasSelection"
        },
        {
          "command": "museCompanion.sendFile",
          "group": "muse@3"
        },
        {
          "command": "museCompanion.askAboutFile",
          "group": "muse@4"
        }
      ],
      "editor/title": [
        {
          "command": "museCompanion.openMuse",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "museCompanion.askTunnelReadFile",
          "group": "muse@1"
        },
        {
          "command": "museCompanion.sendWorkspaceTree",
          "group": "muse@2"
        }
      ],
      "view/title": [
        {
          "command": "museCompanion.openMuse",
          "when": "view == museCompanion.chatView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "museCompanion",
          "title": "Muse",
          "icon": "icons/muse.svg"
        }
      ]
    },
    "views": {
      "museCompanion": [
        {
          "id": "museCompanion.chatView",
          "name": "Chat",
          "type": "webview",
          "icon": "icons/muse.svg",
          "contextualTitle": "Muse Chat"
        }
      ]
    }
  },
  "description": "A VS Code companion for your personal Muse at muse.ai: send files, selections, workspace trees, git diffs, and paths on your machine (via Muse's tunnel) to a Muse chat in one click. Not an official Meta extension.",
  "displayName": "Muse Companion for Muse Web",
  "engines": {
    "vscode": "^1.80.0"
  },
  "license": "Apache-2.0",
  "main": "./extension.js",
  "name": "muse-web-companion",
  "publisher": "matt-local",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/99apps-id/muse-web-companion"
  }
}